<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Idratazione"
            android:textColor="#8be9fd"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_coffee_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="☕ 0"
            android:textColor="#ffb86c"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Water Digits -->
    <LinearLayout
        android:id="@+id/widget_compact_clickable_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_compact_water_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.500"
            android:textColor="#f8f8f2"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_water_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ml su 2.500 ml"
            android:textColor="#8be9fd"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Buttons: Row 1 (-250, +250) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_compact_water_sub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button_bg"
            android:text="-250"
            android:textColor="#f8f8f2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_compact_water_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_accent_bg"
            android:text="+250"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Bottom Buttons: Row 2 (+500, +1 ☕) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_compact_water_add500"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button_accent_bg"
            android:text="+500"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_compact_coffee_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:text="+1 ☕"
            android:textColor="#ffb86c"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>
